{
  "info": {
    "name": "Task Manager API",
    "description": "Etapa 8 API audit collection. Set variables before running; no real secrets are stored.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "token", "value": "" },
    { "key": "taskId", "value": "" },
    { "key": "otherTaskId", "value": "" },
    { "key": "imageId", "value": "" },
    { "key": "audioId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register valid",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Postman User\",\n  \"email\": \"postman@example.com\",\n  \"password\": \"password123\"\n}" }, "url": "{{baseUrl}}/api/auth/register" }
        },
        {
          "name": "Register invalid",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"\",\n  \"email\": \"invalid\",\n  \"password\": \"short\"\n}" }, "url": "{{baseUrl}}/api/auth/register" }
        },
        {
          "name": "Login valid",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"postman@example.com\",\n  \"password\": \"password123\"\n}" }, "url": "{{baseUrl}}/api/auth/login" }
        },
        {
          "name": "Login invalid",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"postman@example.com\",\n  \"password\": \"wrong-password\"\n}" }, "url": "{{baseUrl}}/api/auth/login" }
        },
        {
          "name": "Me with token",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/auth/me" }
        },
        {
          "name": "Me without token",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/auth/me" }
        },
        {
          "name": "Logout",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/auth/logout" }
        }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "Create task",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"Postman task\",\n  \"description\": \"API audit task\"\n}" }, "url": "{{baseUrl}}/api/tasks" }
        },
        {
          "name": "Create task invalid",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"\"\n}" }, "url": "{{baseUrl}}/api/tasks" }
        },
        {
          "name": "List tasks",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/tasks" }
        },
        {
          "name": "List completed tasks",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/tasks?completed=true" }
        },
        {
          "name": "Get task",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/tasks/{{taskId}}" }
        },
        {
          "name": "Get missing task",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/tasks/00000000-0000-4000-8000-000000000000" }
        },
        {
          "name": "Update task",
          "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"completed\": true\n}" }, "url": "{{baseUrl}}/api/tasks/{{taskId}}" }
        },
        {
          "name": "Read other user task",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/tasks/{{otherTaskId}}" }
        },
        {
          "name": "Delete task",
          "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/tasks/{{taskId}}" }
        }
      ]
    },
    {
      "name": "Images",
      "item": [
        {
          "name": "Upload image",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "body": { "mode": "formdata", "formdata": [{ "key": "file", "type": "file", "src": "" }] }, "url": "{{baseUrl}}/api/tasks/{{taskId}}/images" }
        },
        {
          "name": "List images",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/tasks/{{taskId}}/images" }
        },
        {
          "name": "Delete image",
          "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/tasks/{{taskId}}/images/{{imageId}}" }
        },
        {
          "name": "Invalid image mime",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "body": { "mode": "formdata", "formdata": [{ "key": "file", "type": "file", "src": "" }] }, "url": "{{baseUrl}}/api/tasks/{{taskId}}/images" }
        }
      ]
    },
    {
      "name": "Audio",
      "item": [
        {
          "name": "Upload audio",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "body": { "mode": "formdata", "formdata": [{ "key": "duration", "value": "2.5", "type": "text" }, { "key": "file", "type": "file", "src": "" }] }, "url": "{{baseUrl}}/api/tasks/{{taskId}}/audios" }
        },
        {
          "name": "Upload invalid duration",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "body": { "mode": "formdata", "formdata": [{ "key": "duration", "value": "0", "type": "text" }, { "key": "file", "type": "file", "src": "" }] }, "url": "{{baseUrl}}/api/tasks/{{taskId}}/audios" }
        },
        {
          "name": "List audio",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/tasks/{{taskId}}/audios" }
        },
        {
          "name": "Delete audio",
          "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/tasks/{{taskId}}/audios/{{audioId}}" }
        }
      ]
    }
  ]
}
