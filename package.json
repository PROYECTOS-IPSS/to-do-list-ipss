{
  "name": "task-manager-workspace",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "mobile",
    "backend"
  ],
  "scripts": {
    "mobile": "yarn workspace task-manager-mobile start",
    "mobile:dev-client": "yarn workspace task-manager-mobile start:dev-client",
    "backend": "yarn workspace task-manager-backend run dev",
    "backend:start": "yarn workspace task-manager-backend start",
    "typecheck": "yarn workspace task-manager-mobile typecheck && yarn workspace task-manager-backend typecheck",
    "typecheck:tests": "yarn workspace task-manager-backend typecheck:tests",
    "test:backend": "yarn workspace task-manager-backend test",
    "test:mobile": "yarn workspace task-manager-mobile test",
    "test": "yarn test:backend && yarn test:mobile",
    "lint": "eslint --ignore-pattern .yarn --ignore-pattern mobile/dist ."
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "eslint": "^9.33.0",
    "typescript-eslint": "^8.39.0"
  }
}
