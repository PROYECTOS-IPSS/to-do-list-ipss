{
  "name": "task-manager-workspace",
  "private": true,
  "workspaces": [
    "mobile",
    "backend"
  ],
  "scripts": {
    "mobile": "npm --workspace mobile start",
    "mobile:dev-client": "npm --workspace mobile run start:dev-client",
    "backend": "npm --workspace backend run dev",
    "backend:start": "npm --workspace backend start",
    "typecheck": "npm --workspace mobile run typecheck && npm --workspace backend run typecheck",
    "prisma:generate": "npm --workspace backend run prisma:generate",
    "prisma:migrate": "npm --workspace backend run prisma:migrate",
    "test:backend": "npm --workspace backend test",
    "test:mobile": "npm --workspace mobile test",
    "test": "npm run test:backend && npm run test:mobile",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "eslint": "^9.33.0",
    "typescript-eslint": "^8.39.0"
  }
}
